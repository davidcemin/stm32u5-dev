# EMW3080 Wi-Fi driver configuration options

menuconfig EMW3080
	bool "EMW3080 driver support"
	default y
	depends on WIFI && DT_HAS_MXCHIP_EMW3080_ENABLED
	depends on SPI
	depends on GPIO
	help
	  Enable MXCHIP EMW3080 WiFi driver.

if EMW3080

config EMW3080_SPI_LOG_LEVEL
	int "EMW3080 SPI log level"
	range 0 4
	default 2
	help
	  Per-module log level for the emw3080_spi driver.
	  0=NONE, 1=ERR, 2=WRN, 3=INF, 4=DBG.

config EMW3080_LOG_LEVEL
	int "EMW3080 core log level"
	range 0 4
	default 2
	help
	  Per-module log level for the emw3080 core driver.
	  0=NONE, 1=ERR, 2=WRN, 3=INF, 4=DBG.

config EMW3080_INIT_LOG_LEVEL
	int "EMW3080 init log level"
	range 0 4
	default 2
	help
	  Per-module log level for emw3080_init.
	  0=NONE, 1=ERR, 2=WRN, 3=INF, 4=DBG.

config EMW3080_SPI_HOLD_ON_CS
	bool "Keep CS asserted across header+payload read"
	default y
	help
	  When enabled, the driver keeps chip-select asserted while reading
	  the header and then the payload in two back-to-back SPI transfers.
	  Some modules require continuous CS for a full frame.

config EMW3080_SPI_MODE3
		bool "Use SPI Mode 3 (CPOL=1, CPHA=1)"
		default n
		help
			Force SPI mode 3 if the target hardware requires it. Normally the
			default is mode 0; this overrides it in the driver unless DTS sets it.

config EMW3080_SPI_FREQ_HZ
		int "SPI frequency (Hz)"
		default 8000000
		range 500000 20000000
		help
			Override SPI frequency for EMW3080 if DTS frequency is not set.

config EMW3080_RX_STACK_SIZE
	int "Stack size for EMW3080 RX handler"
	default 1024
	help
	  Stack size for the EMW3080 RX handler thread.

config EMW3080_RX_PRIO
	int "Priority for EMW3080 RX handler"
	default 7
	help
	  Priority for the EMW3080 RX handler thread.

endif # EMW3080
