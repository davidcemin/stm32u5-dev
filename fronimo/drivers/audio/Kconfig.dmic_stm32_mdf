# STM32 MDF Digital Microphone configuration options

config DMIC_STM32_MDF
	bool "STM32 MDF Digital Microphone Driver"
	default y
	depends on SOC_FAMILY_STM32
	select USE_STM32_HAL_MDF
	help
	  Enable STM32 MDF (Multi-rate Digital Filter) Digital Microphone driver.
	  This driver supports PDM microphones connected to STM32 MDF peripheral.

if DMIC_STM32_MDF

config DMIC_STM32_MDF_DMA
	bool "STM32 MDF DMA support"
	default y
	help
	  Enable DMA support for STM32 MDF driver.

endif # DMIC_STM32_MDF
