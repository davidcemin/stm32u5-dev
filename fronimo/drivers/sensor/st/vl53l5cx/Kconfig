# ST Microelectronics VL53L5CX Time-of-Flight sensor

# Copyright (c) 2025 David Cemin
# SPDX-License-Identifier: Apache-2.0

menuconfig VL53L5CX
	bool "VL53L5CX Time-of-Flight sensor"
	default y
	depends on DT_HAS_ST_VL53L5CX_ENABLED && I2C
	help
	  Enable driver for VL53L5CX I2C-based Time-of-Flight sensor.
	  This sensor provides multi-zone ranging with 8x8 or 4x4 resolution.

if VL53L5CX

choice VL53L5CX_TRIGGER_MODE
	prompt "Trigger mode"
	default VL53L5CX_TRIGGER_GLOBAL_THREAD
	help
	  Specify the type of triggering to be used by the driver.

config VL53L5CX_TRIGGER_NONE
	bool "No trigger"

config VL53L5CX_TRIGGER_GLOBAL_THREAD
	bool "Use global thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_ST_VL53L5CX),int-gpios)
	select VL53L5CX_TRIGGER

config VL53L5CX_TRIGGER_OWN_THREAD
	bool "Use own thread"
	depends on GPIO
	depends on $(dt_compat_any_has_prop,$(DT_COMPAT_ST_VL53L5CX),int-gpios)
	select VL53L5CX_TRIGGER

endchoice # VL53L5CX_TRIGGER_MODE

config VL53L5CX_TRIGGER
	bool

config VL53L5CX_THREAD_PRIORITY
	int "Thread priority"
	depends on VL53L5CX_TRIGGER_OWN_THREAD
	default 10
	help
	  Priority of thread used by the driver to handle interrupts.

config VL53L5CX_THREAD_STACK_SIZE
	int "Thread stack size"
	depends on VL53L5CX_TRIGGER_OWN_THREAD
	default 1024
	help
	  Stack size of thread used by the driver to handle interrupts.

config VL53L5CX_DEFAULT_RESOLUTION
	int "Default resolution"
	default 16
	range 16 64
	help
	  Default zone resolution: 16 for 4x4, 64 for 8x8.

config VL53L5CX_DEFAULT_FREQUENCY
	int "Default ranging frequency in Hz"
	default 10
	range 1 60
	help
	  Default ranging frequency in Hz.

endif # VL53L5CX
